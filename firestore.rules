rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    match /usernames/{username} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if false; // Created only by the trusted Cloud Function.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower;
      allow delete: if isAdmin();
    }
    match /projects/{projectId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username == userDoc(request.auth.uid).data.username
        && request.resource.data.title is string
        && request.resource.data.languages is list
        && request.resource.data.languages.size() > 0;
      allow update: if signedIn() && (
        isAdmin() || (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.username == resource.data.username)
      );
      allow delete: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }
    match /privateCredentials/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
