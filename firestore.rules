rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Username records are readable so a username can be found at login.
    // A signed-in account can claim a username only for its own UID.
    // Claims cannot be edited or deleted from the public client.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username is string
                    && request.resource.data.usernameLower == username;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Project, review, commission, and chat rules will be added
    // when those collections are implemented. Default deny:
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
